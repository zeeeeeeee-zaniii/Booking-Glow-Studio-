# Supabase project URL — Supabase Dashboard → Project Settings → API → Project URL
# Example: https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Supabase SECRET key (service_role / sb_secret_...) — Supabase Dashboard →
# Project Settings → API Keys. Server-side only: never expose this in the browser.
SUPABASE_SECRET_KEY=

# Passcode for the /admin panel. Choose something long and private.
ADMIN_PASSCODE=
